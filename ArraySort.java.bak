import java.util.Scanner;
class  ArraySort
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.print("enter the n value:");
		int n=sc.nextInt();
		int[] arr=new int[n];
		for(int i=0;i<n;i++){
			arr[i]=sc.nextInt();
		}
		checkSort(arr,n);
		
	}
	public static void checkSort(int[] a,int n){
		int count =1;
		if(a[0]>a[1]){
			for(int i=0;i<n;i++){
			for(int j=i+1;j<n;j++){
			   if (a[i]>a[j])
			   {
				   count++;
			   }
				   	}
		}
		}
		else{
			for(int i=0;i<n;i++){
			for(int j=i+1;j<n;j++){
			   if (a[i]<a[j])
			   {
				   count++;
			   }
				   	}
		}
		}
		
		if(count==n){
			System.out.println("True");
		}
		else {
			System.out.println("False");}
	}
	
}
