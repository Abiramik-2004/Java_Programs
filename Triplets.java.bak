class Triplets 
{
	public static void main(String[] args) 
	{
		int[] a={40,20,20,3,6,7};
		triples(a);
	}
	public static void triples(int[] a){
		int count=0;
		for(int i=0;i<a.length;i++){
			for(int j=i+1;j<a.length;j++){
				for(int k=j+1;k<a.length;k++){
					if((a[i]+a[j]+a[k])==24){
						count++;
				}
			}
		}
		if(count==0){
			System.out.println("False");}
		}
	}
			
					
}
