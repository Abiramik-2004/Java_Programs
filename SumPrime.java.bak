import java.util.Scanner;
class SumPrime 
{
	 static Boolean isPrime(int num){
		if(num<2)return false;
		for(int i=2;i<Math.sqrt(num);i++){
			if(num%i==0) return false;
		}
		return true;
	}
			
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("ente the n for the columns and ros of the matrix");
		int n=sc.nextInt();
		int i,j;
		int a[][]=new int[n][n];
		System.out.println("enter the values for the matrix:");
		for(i=0;i<n;i++){
			for(j=0;j<n;j++){
				a[i][j]=sc.nextInt();
			}
		}
		int count=0;
		for(i=0;i<n;i++){
			for(j=0;j<n;j++){
				while(true){
					if(isPrime(a[i][j])){
						count=count+a[i][j];
						break;
					}
					break;
				}
			}
		}
		System.out.println("the sum of prime number which present on the matrix:");
		System.out.println(count);
	}
}
