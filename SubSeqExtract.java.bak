import java.util.Scanner;
class SubSeqExtract {
	static Scanner sc = new Scanner(System.in);

	public static void seqExtract(CharSequence s) {
		System.out.print("Enter the starting index for extraction (0 - " + (s.length() - 1) + "): ");
		int start = sc.nextInt();

		System.out.print("Enter the ending index for extraction (0 - " + (s.length() - 1) + "): ");
		int end = sc.nextInt();

		System.out.println("The substring is: " + s.subSequence(start, end));
	}

	public static void main(String[] args) {
		System.out.print("Enter the String: ");
		String s = sc.nextLine();
		seqExtract(s);
	}
}
