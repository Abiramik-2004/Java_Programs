import java.util.Scanner;
class DuplicateRemove
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter the length of the array:");
		int n=sc.nextInt();
		int arr[]=new int[n];
		int i;
		int count=0;
		System.out.println("enter the elements present in an array:");
		for(i=0;i<n;i++){
			arr[i]=sc.nextInt();
		}
		for(i=0;i<n;i++){
			if (arr[i]==arr[i+1]){
				for(int j=0;j<n-1;j++){
					arr[j]=arr[j+1];
				}
				count++;
				i--;
			}
		}
		System.out.println("the array after deletion");
		for(i=0;i<n-count;i++){
			System.out.print(arr[i]+" ");
		}
	}
			
}
