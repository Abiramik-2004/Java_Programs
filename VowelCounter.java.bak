import java.util.Scanner;
class VowelCounter 
{
	public static void countVowel(CharSequence s){
		int count=0;
		for(int i=0;i<s.length();i++){
			if(s.charAt(i)=='a'||s.charAt(i)=='e'||s.charAt(i)=='o'||s.charAt(i)=='u'||s.charAt(i)=='i'||s.charAt(i)=='A'||s.charAt(i)=='I'||s.charAt(i)=='E'||s.charAt(i)=='O'||s.charAt(i)=='U'){
				count++;}
		}
	}
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("enter the String");
		String s=sc.nextLine();
		countVowel(s);
	}
}
